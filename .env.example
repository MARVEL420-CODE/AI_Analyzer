# Model default: Gemini 4 Argon (change only if your API project has different model access).
# Put your Gemini API key here in a local .env file.
# Never commit .env or expose this key in VITE_* frontend variables.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-4-argon
PORT=8787
